<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_loading"
    android:gravity="center_vertical"
    android:minWidth="240dp"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="20dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/mc_primary"
        app:indicatorSize="32dp"
        app:trackColor="@color/mc_surface_card_elevated"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/tvLoadingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:fontFamily="@font/inter"
        android:text="@string/loading_generic"
        android:textColor="@color/mc_text_primary"
        android:textSize="15sp" />

</LinearLayout>
