<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BlackBox" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/mc_primary</item>
        <item name="colorOnPrimary">@color/mc_on_primary</item>
        <item name="colorPrimaryContainer">@color/mc_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/mc_on_primary_container</item>

        <item name="colorSecondary">@color/mc_secondary</item>
        <item name="colorOnSecondary">@color/mc_on_secondary</item>
        <item name="colorSecondaryContainer">@color/mc_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/mc_on_secondary_container</item>

        <item name="android:colorBackground">@color/mc_bg</item>
        <item name="colorSurface">@color/mc_surface</item>
        <item name="colorSurfaceVariant">@color/mc_surface_card</item>
        <item name="colorSurfaceContainerLowest">@color/mc_bg</item>
        <item name="colorSurfaceContainerLow">@color/mc_surface</item>
        <item name="colorSurfaceContainer">@color/mc_surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/mc_surface_card_elevated</item>
        <item name="colorSurfaceContainerHighest">#334155</item>
        <item name="colorOnSurface">@color/mc_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/mc_text_secondary</item>
        <item name="colorOutline">@color/mc_outline</item>
        <item name="colorOutlineVariant">@color/mc_outline_subtle</item>

        <item name="colorError">@color/mc_danger</item>
        <item name="colorOnError">@color/mc_on_danger</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/mc_bg</item>

        <item name="actionMenuTextColor">@color/mc_primary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

        <item name="materialAlertDialogTheme">@style/Zenith.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MaxCloner.BottomSheetDialog</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <!-- MaterialDialogs 3.3.0 dark theme tokens -->
        <item name="md_background_color">@color/mc_surface_sheet</item>
        <item name="md_color_title">@color/mc_text_primary</item>
        <item name="md_color_content">@color/mc_text_secondary</item>
        <item name="md_color_button_text">@color/mc_primary</item>
        <item name="md_corner_radius">20dp</item>
    </style>

    <style name="ToolBarColorStyle" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="actionMenuTextColor">@color/mc_primary</item>
        <item name="colorControlNormal">@color/mc_text_primary</item>
        <item name="android:textColorPrimary">@color/mc_text_primary</item>
        <item name="android:textColorSecondary">@color/mc_text_secondary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="WelcomeTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/zenith_boot_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MaxCloner.ShortcutLaunch" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/mc_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ThemeOverlay.MaxCloner.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MaxCloner.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/mc_surface_sheet</item>
    </style>

    <style name="Widget.MaxCloner.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/mc_surface_sheet</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MaxCloner.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.MaxCloner.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Zenith.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/mc_surface_sheet</item>
        <item name="colorSurfaceContainerHigh">@color/mc_surface_sheet</item>
        <item name="colorOnSurface">@color/mc_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/mc_text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MaxCloner.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Zenith.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Zenith.DialogButton.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Zenith.DialogButton.Secondary</item>
    </style>

    <style name="ShapeAppearance.MaxCloner.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Zenith.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/mc_primary</item>
    </style>

    <style name="Zenith.DialogButton.Secondary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/mc_text_secondary</item>
    </style>

    <style name="MaxCloner.SpaceChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/bg_space_chip_selector</item>
        <item name="chipStrokeColor">@color/stroke_space_chip_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/text_space_chip_selector</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
    </style>

    <style name="Zenith.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/mc_text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Zenith.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/mc_text_primary</item>
    </style>

    <style name="Zenith.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/mc_text_primary</item>
    </style>

    <style name="Zenith.LabelMono" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/mc_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="Zenith.LabelMono.Cyan">
        <item name="android:textColor">@color/mc_text_secondary</item>
    </style>

    <style name="Zenith.Fab.Chamfered" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Zenith.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mc_text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

</resources>
