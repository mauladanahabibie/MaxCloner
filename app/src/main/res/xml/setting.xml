<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/category_home_shortcuts">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="auto_pin_shortcut"
            app:summary="@string/auto_pin_summary"
            app:title="@string/auto_pin_title" />

        <Preference
            android:key="shortcut_permission"
            android:summary="@string/shortcut_permission_summary"
            android:title="@string/shortcut_permission_title" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/category_virtual_env">

        <Preference
            android:key="gms_manager"
            android:summary="@string/jump_gms"
            android:title="@string/gms_manager" />

        <SwitchPreferenceCompat
            app:key="root_hide"
            app:title="@string/hide_root" />

        <SwitchPreferenceCompat
            app:key="daemon_enable"
            app:summary="@string/daemon_enable_summary"
            app:title="@string/daemon_enable" />

        <SwitchPreferenceCompat
            app:key="use_vpn_network"
            app:summary="@string/use_vpn_network_summary"
            app:title="@string/use_vpn_network" />

        <SwitchPreferenceCompat
            app:key="disable_flag_secure"
            app:summary="@string/disable_flag_secure_summary"
            app:title="@string/disable_flag_secure" />

    </PreferenceCategory>

</PreferenceScreen>
